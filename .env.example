# Скопируйте этот файл в .env и впишите свои значения. Файл .env не попадает в git.

# Какой ИИ оценивает диалоги: gemini (бесплатный ключ Google) или claude (платный ключ Anthropic)
CQA_PROVIDER=gemini

# Ключ Gemini: https://aistudio.google.com -> Get API key. Вставьте после знака = без пробелов и кавычек
GEMINI_API_KEY=

# Ключ Claude (нужен, только если CQA_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Модель (пусто = по умолчанию: gemini-3.6-flash или claude-opus-5-5)
CQA_MODEL=

# API организаторов (ссылка из чата хакатона). group_id подставляется сам: DEV или PROD
CQA_API_URL=
