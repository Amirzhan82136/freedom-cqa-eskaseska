# Скопируйте этот файл в .env и впишите свои значения. Файл .env не попадает в git.

# Ключ Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Модель (можно не менять)
CQA_MODEL=claude-opus-5-5

# API организаторов. Если не задан, диалоги читаются из папки data/<набор>/
CQA_API_URL=
CQA_API_TOKEN=
